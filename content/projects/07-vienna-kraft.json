      "fest_heading": "Vienna Kraft Bier Fest",
      "fest_text": "Vienna's independent craft beer festival, which we hosted at Gleis//Garten: five editions from the launch in August 2024 to June 2026, with 15+ independent breweries and 50+ beers per edition. I ran it end to end: brewery line-up, ticket shop, email, retargeting, PR and the event itself. In 2026 it was the only craft beer festival left in Vienna.",
      "fest_stats": [
        {
          "figure": "≈€116.3K",
          "label": "estimated total revenue: tickets online, at the door and tasting tokens, 2025–26"
        },
        {
          "figure": "2,177",
          "label": "tickets sold online, ≈2,830 ticket holders incl. door sales"
        },
        {
          "figure": "1,003",
          "label": "unique buyers, 116 came back for two or more editions"
        },
        {
          "figure": "+27%",
          "label": "online revenue 2026 vs 2025 (€32.9K → €41.7K)"
        },
        {
          "figure": "739",
          "label": "online tickets for Feb 2026, the best edition yet"
        },
        {
          "figure": "40+",
          "label": "articles in major newspapers and media"
        }
      ],
