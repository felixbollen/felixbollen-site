      ],
      "points": [
        {
          "title": "Concept & business plan",
          "text": "The 'culinary house of culture' idea: no consumption minimum, no table service, art, music and events every week. Layouts, renderings and the plan behind them."
        },
        {
          "title": "Vendor acquisition & leasing",
          "text": "Wrote the food vendor package, signed the five concepts (Mani in Pasta, Abuya, The Curried Cactus, Tacho, Domberger Brot-Werk) and negotiated the subleases and addenda."
        },
        {
          "title": "Build-out & opening",
          "text": "Facade signage and neon, furniture, floor plan and the opening itself in May 2026."
        },
        {
          "title": "Operations & systems",
          "text": "Lightspeed POS and cash rules for all tenants, opening hours, staffing set-up and revenue reporting across the vendors."
        },
        {
          "title": "Marketing & communication",
          "text": "Pre-opening teasers, Open House events, Instagram launch, newsletter, website brief for dufteberlin.com and the press that followed."
        },
        {
          "title": "Weekly programme",
          "text": "Formats like Kaffee Happy Hour, Tankrabatt Donnerstag, Freibier Freitag, Die Berliner Auster, Bingo, Kneipenquiz and comedy nights."
        },
        {
          "title": "B2B events & sales",
          "text": "Event deck and sales for brand events, together with the 1,500 m² event loft on the 5th floor. Booked by Google, Hermès, Adidas × Zalando, Lululemon and more."
        },
        {
          "title": "Investors & partners",
          "text": "Investor deck, landlord relations and the partnership with Better Life, who run the event loft."
        }
      ],
